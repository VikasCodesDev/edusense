# ===================================================
# EduSense Environment Configuration
# ===================================================

# Node.js Server Environment
NODE_ENV=production
PORT=5000

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas in production; JSON remains for local development if unset)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edusense?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret (Used for JWT signing)
JWT_SECRET=edusense_super_secret_jwt_key_2026_academic_system
AUTH_SECRET=edusense_super_secret_jwt_key_2026_academic_system

# Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000

# LLM Recommendation Provider Configuration (Free Tier Compatible)
# Provider: groq | mock | deterministic_rules
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Free Groq API Key (Get free key at https://console.groq.com)
# If left empty, EduSense automatically switches to its Deterministic Academic Guidance Engine
LLM_API_KEY=
GROQ_API_KEY=
