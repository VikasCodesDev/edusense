# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep the example environment file
!.env.example


# ------------------------------
# Node.js
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ------------------------------
# Next.js
# ------------------------------
.next/
out/
.next/cache/


# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# ------------------------------
# Python / ML Generated Files
# ------------------------------
*.tmp
*.temp

# Joblib temporary files
*.joblib.tmp

# Jupyter
.ipynb_checkpoints/


# ------------------------------
# Logs
# ------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# ------------------------------
# OS Generated Files
# ------------------------------
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# ------------------------------
# IDE / Editors
# ------------------------------
.vscode/
.idea/
*.swp
*.swo
*~


# ------------------------------
# Build / Coverage
# ------------------------------
dist/
build/
coverage/


# ------------------------------
# Temporary Files
# ------------------------------
*.bak
*.backup
*.old
*.orig
*.rej


# ------------------------------
# Local Database / Runtime Data
# ------------------------------
*.sqlite
*.sqlite3
*.db

# Runtime PID files
*.pid
*.pid.lock


# ------------------------------
# Cache
# ------------------------------
.cache/
.parcel-cache/
.turbo/


# ------------------------------
# Vercel
# ------------------------------
.vercel/


# ------------------------------
# Generated TypeScript / Next files
# ------------------------------
*.tsbuildinfo


# ------------------------------
# Temporary Excel / Office files
# ------------------------------
~$*.xlsx
~$*.xls
~$*.csv


# ------------------------------
# Python distribution
# ------------------------------
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/


# ------------------------------
